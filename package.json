{
  "name": "template-fastify",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Fastify base template with autoloaded plugins and Zod-validated env",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagon/template-fastify.git"
  },
  "bugs": {
    "url": "https://github.com/thiagon/template-fastify/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fastify/autoload": "6.6.0",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/otel": "1.0.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/under-pressure": "9.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@platformatic/prom-client": "2.0.0",
    "@scalar/fastify-api-reference": "1.82.1",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.8",
    "fastify-metrics": "15.0.1",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "http-errors": "2.0.1",
    "http-status": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/http-errors": "2.0.5",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
