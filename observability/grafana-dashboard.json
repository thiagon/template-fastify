    {
      "type": "table",
      "title": "Endpoints",
      "description": "Per endpoint over the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (method, route) (increase(http_request_duration_seconds_count{service_name=\"$service\", route=~\"$route\"}[$__range])) / $__range_s",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (increase(http_request_duration_seconds_bucket{service_name=\"$service\", route=~\"$route\"}[$__range])))",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum by (method, route) (rate(http_request_duration_seconds_count{service_name=\"$service\", route=~\"$route\", status_code=~\"5..\"}[$__range])) or (sum by (method, route) (rate(http_request_duration_seconds_count{service_name=\"$service\", route=~\"$route\"}[$__range])) * 0)) / sum by (method, route) (rate(http_request_duration_seconds_count{service_name=\"$service\", route=~\"$route\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum by (method, route) (rate(http_request_duration_seconds_count{service_name=\"$service\", route=~\"$route\", status_code=~\"4..\"}[$__range])) or (sum by (method, route) (rate(http_request_duration_seconds_count{service_name=\"$service\", route=~\"$route\"}[$__range])) * 0)) / sum by (method, route) (rate(http_request_duration_seconds_count{service_name=\"$service\", route=~\"$route\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "method": 0,
              "route": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "method": "Method",
              "route": "Route",
              "Value #A": "Requests / s",
              "Value #B": "p95",
              "Value #C": "5xx",
              "Value #D": "4xx"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests / s",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
